---
import { nav, path, motto, location, ui, siteName, type Lang, type PageKey } from '../content/site';
import LangSwitch from './LangSwitch.astro';
import VulaMarchio from './brand/VulaMarchio.astro';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const n = nav[lang];
const year = 2026;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <span class="site-footer__mark">
        <VulaMarchio />
      </span>
      <p class="site-footer__word">{siteName}</p>
      <p class="site-footer__motto mono">{motto[lang]}</p>
    </div>

    <nav class="site-footer__col" aria-label={n.home}>
      <p class="label-title mono">{n.home}</p>
      <a href={path(lang, 'home')}>{n.home}</a>
      <a href={path(lang, 'services')}>{n.services}</a>
      <a href={path(lang, 'portfolio')}>{n.portfolio}</a>
      <a href={path(lang, 'about')}>{n.about}</a>
      <a href={path(lang, 'contact')}>{n.contact}</a>
    </nav>

    <div class="site-footer__col">
      <p class="label-title mono">{n.contact}</p>
      <p>{location[lang]}</p>
      <!-- DA FORNIRE: indirizzo completo, telefono, email di VULA (SQ/IT/EN identici tranne la città) -->
      <p class="todo-line mono">[{ui[lang].todo}: indirizzo, telefono, email]</p>
    </div>

    <div class="site-footer__col">
      <p class="label-title mono">{ui[lang].langSwitcher}</p>
      <LangSwitch lang={lang} page={page} variant="footer" />
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p class="mono">© {year} {siteName}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(48px, 8vw, 96px) 32px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__mark {
    width: 40px;
    height: 40px;
    color: var(--paper);
  }

  .site-footer__word {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.95rem;
    margin: 0;
  }

  .site-footer__motto {
    color: var(--dim);
    font-size: 0.66rem;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.9rem;
  }

  .site-footer__col a {
    color: var(--dim);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--paper);
  }

  .site-footer__col p {
    color: var(--dim);
    margin: 0;
  }

  .label-title {
    color: var(--paper);
    font-size: 0.66rem;
    margin-bottom: 2px;
  }

  .todo-line {
    font-size: 0.62rem;
    color: var(--timbro);
    opacity: 0.85;
  }

  .site-footer__bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--dim);
  }

  @media (max-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
