---
import {
  nav,
  path,
  siteName,
  siteMark,
  location,
  ui,
  LANGS,
  langLabel,
  routes,
  type Lang,
  type RouteKey,
} from '../content/site';
import { concepts } from '../content/vault';
import VulaMarchio from './brand/VulaMarchio.astro';

interface Props {
  lang: Lang;
  alternates?: Record<Lang, string>;
  page?: RouteKey;
}
const { lang, alternates, page = 'home' } = Astro.props;
const t = ui[lang];
const alts = alternates ?? (Object.fromEntries(LANGS.map((l) => [l, path(l, page)])) as Record<Lang, string>);
const year = 2026;
const marquee = Array.from({ length: 8 }, () => siteMark);
---

<footer class="ftr">
  <div class="ftr__marquee" aria-hidden="true">
    <div class="ftr__track">
      {
        [0, 1].map(() => (
          <span class="ftr__set">
            {marquee.map(() => (
              <span class="ftr__word">
                {siteMark}
                <i class="ftr__sep" />
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <div class="container ftr__grid">
    <div class="ftr__brand">
      <span class="ftr__mark"><VulaMarchio /></span>
      <p class="ftr__name">{siteName}</p>
      <p class="ftr__place mono">{location[lang]}</p>
    </div>

    <nav class="ftr__col" aria-label="VULA">
      <p class="ftr__title mono">{lang === 'sq' ? 'Faqja' : lang === 'it' ? 'Sito' : 'Site'}</p>
      {nav[lang].map((l) => <a href={`${path(lang, 'home')}${l.href}`}>{l.label}</a>)}
      <a href={path(lang, 'contact')}>{lang === 'sq' ? 'Kontakt' : lang === 'it' ? 'Contatto' : 'Contact'}</a>
    </nav>

    <nav class="ftr__col" aria-label="Koncept Vault">
      <p class="ftr__title mono">Koncept Vault</p>
      {
        concepts.slice(0, 6).map((c) => (
          <a href={`/${lang}/${routes.concepts[lang]}/${c.slug}/`}>{c.name}</a>
        ))
      }
    </nav>

    <nav class="ftr__col" aria-label={t.langSwitcher}>
      <p class="ftr__title mono">{t.langSwitcher}</p>
      {
        LANGS.map((l) => (
          <a href={alts[l]} aria-current={l === lang ? 'true' : undefined}>
            {langLabel[l]}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container ftr__base">
    <p class="mono">© {year} {siteName}</p>
    <p class="mono">{lang === 'sq' ? 'Tiranë' : 'Tirana'}</p>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--line);
    padding-top: clamp(48px, 7vw, 90px);
    overflow: hidden;
  }

  /* marquee del logotipo (cap. 4.2) */
  .ftr__marquee {
    padding-bottom: clamp(40px, 6vw, 80px);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }

  .ftr__track {
    display: flex;
    width: max-content;
    animation: ftr-scroll 42s linear infinite;
  }

  .ftr__set {
    display: flex;
  }

  .ftr__word {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 9rem);
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 241, 234, 0.22);
  }

  .ftr__sep {
    display: inline-block;
    width: clamp(24px, 3vw, 52px);
    height: clamp(6px, 0.9vw, 11px);
    margin-inline: clamp(20px, 2.5vw, 44px);
    background: var(--tint);
    border-radius: 999px;
  }

  @keyframes ftr-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: clamp(28px, 4vw, 56px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .ftr__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .ftr__mark {
    display: block;
    width: 44px;
    aspect-ratio: 1;
    color: var(--paper);
  }

  .ftr__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ftr__place {
    font-size: 0.68rem;
    color: var(--dim);
  }

  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.92rem;
  }

  .ftr__title {
    font-size: 0.62rem;
    color: var(--paper);
    margin-bottom: 0.35rem;
  }

  .ftr__col a {
    color: var(--dim);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .ftr__col a:hover,
  .ftr__col a[aria-current='true'] {
    color: var(--paper);
  }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.64rem;
    color: var(--dim);
  }

  @media (max-width: 860px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ftr__track {
      animation: none;
    }
  }
</style>
