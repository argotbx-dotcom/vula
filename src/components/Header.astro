---
import { nav, path, ctaFinal, ui, LANGS, langLabel, type Lang, type RouteKey } from '../content/site';
import VulaLockupOrizzontale from './brand/VulaLockupOrizzontale.astro';

interface Props {
  lang: Lang;
  /** Alternate per lingua, per il selettore (default: stessa pagina). */
  alternates?: Record<Lang, string>;
  page?: RouteKey;
}
const { lang, alternates, page = 'home' } = Astro.props;
const t = ui[lang];
const links = nav[lang];
const alts = alternates ?? (Object.fromEntries(LANGS.map((l) => [l, path(l, page)])) as Record<Lang, string>);
---

<header class="hdr">
  <div class="container hdr__row">
    <a class="hdr__brand" href={path(lang, 'home')} aria-label={t.homeAria}>
      <span class="hdr__logo"><VulaLockupOrizzontale /></span>
    </a>

    <nav class="hdr__nav" aria-label="VULA">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="hdr__end">
      <nav class="langs" aria-label={t.langSwitcher}>
        {
          LANGS.map((l) => (
            <a href={alts[l]} aria-current={l === lang ? 'true' : undefined}>
              {l.toUpperCase()}
              <span class="visually-hidden">{langLabel[l]}</span>
            </a>
          ))
        }
      </nav>

      <a class="btn btn--primary hdr__cta" href={path(lang, 'contact')} data-magnetic="6">
        {ctaFinal[lang].button}
      </a>

      <details class="burger">
        <summary aria-label={t.menu}><span class="burger__icon" aria-hidden="true"></span></summary>
        <div class="burger__panel">
          <nav aria-label={t.menu}>
            {links.map((l) => <a href={l.href}>{l.label}</a>)}
            <a href={path(lang, 'contact')}>{ctaFinal[lang].button}</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: linear-gradient(to bottom, rgba(10, 10, 11, 0.92), rgba(10, 10, 11, 0));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hdr__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .hdr__brand {
    line-height: 0;
    color: var(--paper);
    text-decoration: none;
  }

  .hdr__logo {
    display: block;
    width: 104px;
    aspect-ratio: 700 / 200;
  }

  .hdr__nav {
    display: none;
    gap: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hdr__nav a {
    color: var(--dim);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .hdr__nav a:hover {
    color: var(--paper);
  }

  .hdr__end {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .langs {
    display: flex;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
  }

  .langs a {
    padding: 0.35rem 0.45rem;
    color: var(--dim);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .langs a:hover,
  .langs a[aria-current='true'] {
    color: var(--paper);
  }

  .hdr__cta {
    display: none;
    padding: 0.85rem 1.4rem;
    font-size: 0.66rem;
  }

  /* menu mobile */
  .burger summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .burger summary::-webkit-details-marker {
    display: none;
  }

  .burger__icon,
  .burger__icon::before,
  .burger__icon::after {
    display: block;
    width: 15px;
    height: 1.5px;
    background: var(--paper);
  }

  .burger__icon {
    position: relative;
  }

  .burger__icon::before,
  .burger__icon::after {
    content: '';
    position: absolute;
  }

  .burger__icon::before {
    top: -5px;
  }
  .burger__icon::after {
    top: 5px;
  }

  .burger__panel {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) - 6px);
    min-width: 220px;
    padding: 1.4rem;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .burger__panel nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .burger__panel a {
    color: var(--paper);
    text-decoration: none;
  }

  @media (min-width: 1000px) {
    .hdr__nav,
    .hdr__cta {
      display: flex;
    }
    .burger {
      display: none;
    }
    .hdr__logo {
      width: 118px;
    }
  }
</style>
