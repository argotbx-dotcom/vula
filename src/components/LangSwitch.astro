---
import { LANGS, langLabel, path, ui, type Lang, type PageKey } from '../content/site';

interface Props {
  lang: Lang;
  page: PageKey;
  variant?: 'header' | 'footer';
}
const { lang, page, variant = 'header' } = Astro.props;
---

<nav class={`lang-switch lang-switch--${variant}`} aria-label={ui[lang].langSwitcher}>
  {
    LANGS.map((l) => (
      <a href={path(l, page)} aria-current={l === lang ? 'true' : undefined} class="lang-switch__item">
        {l.toUpperCase()}
        <span class="visually-hidden">{langLabel[l]}</span>
      </a>
    ))
  }
</nav>

<style>
  .lang-switch {
    display: flex;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .lang-switch__item {
    padding: 6px 8px;
    color: var(--dim);
    text-decoration: none;
    border-radius: 2px;
    transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }

  .lang-switch__item:hover {
    color: var(--paper);
  }

  .lang-switch__item[aria-current='true'] {
    color: var(--paper);
    background: var(--surface2);
  }

  .lang-switch--footer .lang-switch__item {
    color: var(--dim);
  }
</style>
