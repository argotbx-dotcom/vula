---
// Video in loop, muto, che non parte mai su schermo nero (cap. 8):
// il poster è sempre presente e i byte del video partono solo quando
// l'elemento entra in viewport (preload="none" + IntersectionObserver).
import { getImage } from 'astro:assets';

interface Props {
  /** nome file senza estensione in /public/videos */
  name: string;
  poster: ImageMetadata;
  width?: number;
  class?: string;
}
const { name, poster, width = 1200, class: className } = Astro.props;
const p = await getImage({ src: poster, width, format: 'webp' });
---

<video
  class={className}
  data-lazy
  poster={p.src}
  muted
  loop
  playsinline
  preload="none"
  tabindex="-1"
  aria-hidden="true"
>
  <source src={`/videos/${name}.webm`} type="video/webm" />
  <source src={`/videos/${name}.mp4`} type="video/mp4" />
</video>
