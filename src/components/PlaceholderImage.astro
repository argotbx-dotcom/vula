---
// Segnaposto grafico per schede senza immagine (brief §7): fondo --surface2
// con il simbolo VULA in --line. Mai una foto stock generica.
import VulaSimbolo from './brand/VulaSimbolo.astro';

interface Props {
  ratio?: string; // es. '4 / 3'
  class?: string;
}
const { ratio = '4 / 3', class: className } = Astro.props;
---

<div class={`img-placeholder ${className ?? ''}`} style={`--ph-ratio: ${ratio}`}>
  <span class="img-placeholder__mark">
    <VulaSimbolo />
  </span>
</div>

<style>
  .img-placeholder__mark {
    display: block;
    width: 34%;
    aspect-ratio: 1 / 1;
    color: var(--line);
  }
</style>
