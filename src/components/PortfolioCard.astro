---
// Card portfolio — full-bleed editoriale (ispirata alla struttura delle
// card viste in analisi-siti-riferimento.md: immagine intera, nome ed
// etichetta sovrapposti). Regola di onestà vincolante (brief §6/7):
// l'etichetta resta sempre visibile sulla card, mai nascosta nel dettaglio.
import { Image } from 'astro:assets';
import { ui, type Lang } from '../content/site';
import type { PortfolioItem } from '../content/portfolio';
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  lang: Lang;
  item: PortfolioItem;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { lang, item, image, imageAlt } = Astro.props;
const t = ui[lang];

const labelText = item.category === 'group' ? t.labelGroupBrand : item.category === 'concept' ? t.labelConcept : t.labelClient;
---

<article class="pf-card">
  <div class="pf-card__frame">
    <div class="pf-card__media">
      {
        Astro.slots.has('media') ? (
          <slot name="media" />
        ) : image ? (
          <Image src={image} alt={imageAlt ?? ''} width={720} height={960} />
        ) : (
          <PlaceholderImage ratio="3 / 4" class="pf-card__ph" />
        )
      }
    </div>
    <span class={`pf-card__label label ${item.category === 'concept' ? 'label--concept' : ''}`}>{labelText}</span>

    <div class="pf-card__overlay" aria-hidden="true"></div>

    <div class="pf-card__text">
      <h3 class="pf-card__name">
        {item.name ? item.name[lang] : <span class="mono todo-inline">[{t.todo}]</span>}
      </h3>
      {item.year && <p class="pf-card__year mono">{item.year}</p>}
      {item.description && <p class="pf-card__desc">{item.description[lang]}</p>}
      {
        item.descriptionTbd && (
          <p class="pf-card__desc mono todo-inline">
            <!-- DA FORNIRE: una riga di descrizione per questa scheda, SQ/IT/EN -->[{t.todo}]
          </p>
        )
      }
    </div>
  </div>
</article>

<style>
  .pf-card__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 3 / 4;
    transition: border-color 180ms var(--ease);
  }

  .pf-card:hover .pf-card__frame {
    border-color: rgba(239, 234, 224, 0.28);
  }

  .pf-card__media,
  .pf-card__media :global(.img-placeholder),
  .pf-card__media :global(.pf-card__slot),
  .pf-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pf-card__media :global(img) {
    object-fit: cover;
  }

  .pf-card__media,
  .pf-card__media :global(*) {
    transition: transform 200ms var(--ease);
  }

  .pf-card:hover .pf-card__media :global(.img-placeholder),
  .pf-card:hover .pf-card__media :global(.pf-card__slot),
  .pf-card:hover .pf-card__media :global(img) {
    transform: scale(1.045);
  }

  .pf-card__label {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
  }

  .label--concept {
    background: var(--timbro);
    color: var(--paper);
  }

  .pf-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 16, 20, 0) 45%, rgba(16, 16, 20, 0.86) 100%);
    z-index: 1;
  }

  .pf-card__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pf-card__name {
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--paper);
  }

  .pf-card__year {
    color: var(--dim);
    font-size: 0.64rem;
  }

  .pf-card__desc {
    color: var(--dim);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .todo-inline {
    color: var(--timbro);
    font-size: 0.68rem;
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-card:hover .pf-card__media :global(.img-placeholder),
    .pf-card:hover .pf-card__media :global(.pf-card__slot),
    .pf-card:hover .pf-card__media :global(img) {
      transform: none;
    }
  }
</style>
