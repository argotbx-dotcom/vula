---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { contactPage, ctaFinal, location, ui, siteName, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = contactPage[lang];
const t = ui[lang];

const formName = { sq: 'kontakt-sq', it: 'contatto-it', en: 'contact-en' }[lang];
const botLabel = {
  sq: 'Mos e plotëso këtë fushë',
  it: 'Non compilare questo campo',
  en: "Don't fill this field out",
}[lang];
---

<Base lang={lang} page="contact" title={`${c.title} · ${siteName}`} description={c.line}>
  <Header lang={lang} page="contact" />

  <main id="main">
    <section class="ct">
      <div class="blueprint" aria-hidden="true"></div>

      <div class="container ct__grid">
        <div class="ct__intro">
          <p class="kicker" data-reveal>{c.kicker}</p>
          <h1 class="display display--lg ct__title" data-reveal data-reveal-delay="0.05">{c.title}</h1>
          <p class="lede ct__lede" data-reveal data-reveal-delay="0.1">{c.line}</p>
          <p class="ct__place mono" data-reveal data-reveal-delay="0.15">{location[lang]}</p>
        </div>

        <form
          class="ct__form"
          name={formName}
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-reveal
          data-reveal-delay="0.12"
        >
          <input type="hidden" name="form-name" value={formName} />
          <p class="visually-hidden">
            <label>
              {botLabel}
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <label class="ct__field">
            <span class="mono">{t.formName}</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="ct__field">
            <span class="mono">{t.formEmail}</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="ct__field">
            <span class="mono">{t.formMessage}</span>
            <textarea name="message" rows="5" required></textarea>
          </label>

          <button type="submit" class="btn btn--primary" data-magnetic="8">
            {ctaFinal[lang].button}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer lang={lang} page="contact" />
</Base>

<style>
  .ct {
    position: relative;
    padding-block: calc(var(--header-h) + clamp(60px, 9vw, 120px)) clamp(80px, 10vw, 150px);
    min-height: 92svh;
  }

  .ct__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .ct__title {
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .ct__lede {
    margin-top: 1.4rem;
  }

  .ct__place {
    margin-top: 2rem;
    font-size: 0.64rem;
    color: var(--dim);
  }

  .ct__form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .ct__field {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .ct__field span {
    font-size: 0.58rem;
    color: var(--dim);
  }

  .ct__field input,
  .ct__field textarea {
    width: 100%;
    padding: 1rem 1.1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--paper);
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    resize: vertical;
    transition: border-color 0.2s var(--ease);
  }

  .ct__field input:focus,
  .ct__field textarea:focus {
    border-color: var(--tint);
  }

  .ct__form button {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media (min-width: 860px) {
    .ct__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
