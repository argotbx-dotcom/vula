---
// Project brief, non un form di contatto generico.
// Un contatto qualificato vale molto più di un "scrivici": le domande qui
// sono quelle che servono per rispondere con il primo passo concreto.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { brief, location, siteName, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = brief[lang];

const formName = { sq: 'brief-sq', it: 'brief-it', en: 'brief-en' }[lang];
const botLabel = {
  sq: 'Mos e plotëso këtë fushë',
  it: 'Non compilare questo campo',
  en: "Don't fill this field out",
}[lang];
---

<Base lang={lang} page="contact" title={`${b.title} · ${siteName}`} description={b.line}>
  <Header lang={lang} page="contact" />

  <main id="main">
    <section class="bf">
      <div class="blueprint" aria-hidden="true"></div>

      <div class="container bf__inner">
        <header class="bf__head">
          <p class="kicker" data-reveal>{b.kicker}</p>
          <h1 class="display display--lg bf__title" data-reveal data-reveal-delay="0.05">{b.title}</h1>
          <p class="lede bf__lede" data-reveal data-reveal-delay="0.1">{b.line}</p>
          <p class="bf__place mono" data-reveal data-reveal-delay="0.15">{location[lang]}</p>
        </header>

        <form
          class="bf__form"
          name={formName}
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-reveal
          data-reveal-delay="0.12"
        >
          <input type="hidden" name="form-name" value={formName} />
          <p class="visually-hidden">
            <label>
              {botLabel}
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <!-- il progetto -->
          <div class="bf__row">
            <label class="bf__field">
              <span class="mono">{b.what}</span>
              <input type="text" name="cosa" />
            </label>
            <label class="bf__field">
              <span class="mono">{b.where}</span>
              <input type="text" name="dove" />
            </label>
          </div>

          <div class="bf__row">
            <label class="bf__field">
              <span class="mono">{b.hasSpace}</span>
              <select name="locale">
                <option value=""></option>
                {b.hasSpaceOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
            <label class="bf__field">
              <span class="mono">{b.hasBrand}</span>
              <select name="marca">
                <option value=""></option>
                {b.hasBrandOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
          </div>

          <label class="bf__field">
            <span class="mono">{b.capital}</span>
            <input type="text" name="capitale" />
            <small class="bf__hint">{b.capitalHint}</small>
          </label>

          <!-- di cosa ha bisogno -->
          <fieldset class="bf__fieldset">
            <legend class="mono">{b.needs}</legend>
            <div class="bf__checks">
              {
                b.needsOptions.map((o) => (
                  <label class="bf__check">
                    <input type="checkbox" name="serve" value={o} />
                    <span>{o}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class="bf__field">
            <span class="mono">{b.notes}</span>
            <textarea name="note" rows="4"></textarea>
          </label>

          <hr class="rule bf__sep" />

          <!-- contatto: l'unica parte obbligatoria -->
          <div class="bf__row">
            <label class="bf__field">
              <span class="mono">{b.name} *</span>
              <input type="text" name="nome" autocomplete="name" required />
            </label>
            <label class="bf__field">
              <span class="mono">{b.email} *</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </div>

          <label class="bf__field">
            <span class="mono">{b.phone}</span>
            <input type="tel" name="telefon" autocomplete="tel" />
          </label>

          <button type="submit" class="btn btn--primary bf__submit" data-magnetic="8">
            {b.submit}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer lang={lang} page="contact" />
</Base>

<style>
  .bf {
    position: relative;
    padding-block: calc(var(--header-h) + clamp(56px, 8vw, 110px)) clamp(80px, 10vw, 150px);
  }

  .bf__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .bf__title {
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .bf__lede {
    margin-top: 1.3rem;
  }

  .bf__place {
    margin-top: 1.8rem;
    font-size: 0.64rem;
    color: var(--dim);
  }

  .bf__form {
    display: grid;
    gap: 1.5rem;
  }

  .bf__row {
    display: grid;
    gap: 1.5rem;
  }

  .bf__field {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .bf__field > span {
    font-size: 0.58rem;
    color: var(--dim);
  }

  .bf__field input,
  .bf__field select,
  .bf__field textarea {
    width: 100%;
    padding: 0.95rem 1.05rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--paper);
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    resize: vertical;
    transition: border-color 0.2s var(--ease);
  }

  .bf__field select {
    appearance: none;
    cursor: pointer;
  }

  .bf__field input:focus,
  .bf__field select:focus,
  .bf__field textarea:focus {
    border-color: var(--tint);
  }

  .bf__hint {
    font-size: 0.76rem;
    color: var(--dim);
    opacity: 0.8;
  }

  .bf__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .bf__fieldset legend {
    padding: 0 0 0.85rem;
    font-size: 0.58rem;
    color: var(--dim);
  }

  .bf__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .bf__check {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1rem;
    font-size: 0.86rem;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .bf__check:hover {
    border-color: rgba(244, 241, 234, 0.3);
  }

  .bf__check input {
    width: 15px;
    height: 15px;
    accent-color: var(--tint);
    cursor: pointer;
  }

  .bf__check:has(input:checked) {
    border-color: var(--tint);
    color: var(--paper);
  }

  .bf__sep {
    margin-block: 0.6rem;
  }

  .bf__submit {
    justify-self: start;
    margin-top: 0.4rem;
  }

  @media (min-width: 620px) {
    .bf__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .bf__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
      gap: clamp(3rem, 6vw, 7rem);
    }
    .bf__head {
      position: sticky;
      top: calc(var(--header-h) + 40px);
    }
  }
</style>
