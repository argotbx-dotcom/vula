---
// Project brief, non un form di contatto generico.
// Un contatto qualificato vale molto più di un "scrivici": le domande qui
// sono quelle che servono per rispondere con il primo passo concreto.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { brief, location, siteName, whatsappNumber, whatsappIntro, whatsappCta, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = brief[lang];

// Il brief non viaggia su un server: viene composto in un messaggio WhatsApp
// già scritto. Senza numero configurato il pulsante non esiste.
const hasWa = whatsappNumber.length > 0;
---

<Base lang={lang} page="contact" title={`${b.title} · ${siteName}`} description={b.line}>
  <Header lang={lang} page="contact" />

  <main id="main">
    <section class="bf">
      <div class="blueprint" aria-hidden="true"></div>

      <div class="container bf__inner">
        <header class="bf__head">
          <p class="kicker" data-reveal>{b.kicker}</p>
          <h1 class="display display--lg bf__title" data-reveal data-reveal-delay="0.05">{b.title}</h1>
          <p class="lede bf__lede" data-reveal data-reveal-delay="0.1">{b.line}</p>
          <p class="bf__place mono" data-reveal data-reveal-delay="0.15">{location[lang]}</p>

          {
            hasWa && (
              <a
                class="btn btn--ghost bf__wa"
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappIntro[lang])}`}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
                data-reveal-delay="0.2"
                data-magnetic="6"
              >
                {whatsappCta[lang]}
                <span class="btn__arrow" aria-hidden="true">↗</span>
              </a>
            )
          }
        </header>

        {hasWa && (
        <form class="bf__form" data-brief data-wa={whatsappNumber} data-intro={whatsappIntro[lang]} data-reveal data-reveal-delay="0.12">

          <!-- il progetto -->
          <div class="bf__row">
            <label class="bf__field" data-label={b.what}>
              <span class="mono">{b.what}</span>
              <input type="text" name="cosa" />
            </label>
            <label class="bf__field" data-label={b.where}>
              <span class="mono">{b.where}</span>
              <input type="text" name="dove" />
            </label>
          </div>

          <div class="bf__row">
            <label class="bf__field" data-label={b.hasSpace}>
              <span class="mono">{b.hasSpace}</span>
              <select name="locale">
                <option value=""></option>
                {b.hasSpaceOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
            <label class="bf__field" data-label={b.hasBrand}>
              <span class="mono">{b.hasBrand}</span>
              <select name="marca">
                <option value=""></option>
                {b.hasBrandOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
          </div>

          <label class="bf__field" data-label={b.capital}>
            <span class="mono">{b.capital}</span>
            <input type="text" name="capitale" />
            <small class="bf__hint">{b.capitalHint}</small>
          </label>

          <!-- di cosa ha bisogno -->
          <fieldset class="bf__fieldset" data-label={b.needs}>
            <legend class="mono">{b.needs}</legend>
            <div class="bf__checks">
              {
                b.needsOptions.map((o) => (
                  <label class="bf__check">
                    <input type="checkbox" name="serve" value={o} />
                    <span>{o}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class="bf__field" data-label={b.notes}>
            <span class="mono">{b.notes}</span>
            <textarea name="note" rows="4"></textarea>
          </label>

          <hr class="rule bf__sep" />

          <!-- contatto: l'unica parte obbligatoria -->
          <div class="bf__row">
            <label class="bf__field" data-label={b.name}>
              <span class="mono">{b.name} *</span>
              <input type="text" name="nome" autocomplete="name" required />
            </label>
            <label class="bf__field" data-label={b.email}>
              <span class="mono">{b.email} *</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </div>

          <label class="bf__field" data-label={b.phone}>
            <span class="mono">{b.phone}</span>
            <input type="tel" name="telefon" autocomplete="tel" />
          </label>

          <button type="submit" class="btn btn--primary bf__submit" data-magnetic="8">
            {b.submit}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </form>
        )}
      </div>
    </section>
  </main>

  <Footer lang={lang} page="contact" />
</Base>

<script>
  // Il brief non viene inviato a un server: viene formattato in un messaggio
  // WhatsApp già scritto. Nessun dato lascia il dispositivo finché non è
  // l'utente stesso a premere invio dentro WhatsApp.
  const form = document.querySelector<HTMLFormElement>('[data-brief]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const number = form.dataset.wa;
    if (!number) return;

    const parts: string[] = [form.dataset.intro || ''];

    form.querySelectorAll<HTMLElement>('[data-label]').forEach((group) => {
      const label = group.dataset.label || '';
      const checks = group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked');

      if (checks.length) {
        parts.push(`${label}: ${Array.from(checks).map((c) => c.value).join(', ')}`);
        return;
      }

      const field = group.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input:not([type="checkbox"]), select, textarea'
      );
      const value = field?.value.trim();
      if (value) parts.push(`${label}: ${value}`);
    });

    window.open(`https://wa.me/${number}?text=${encodeURIComponent(parts.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  .bf {
    position: relative;
    padding-block: calc(var(--header-h) + clamp(56px, 8vw, 110px)) clamp(80px, 10vw, 150px);
  }

  .bf__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .bf__title {
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .bf__lede {
    margin-top: 1.3rem;
  }

  .bf__place {
    margin-top: 1.8rem;
    font-size: 0.64rem;
    color: var(--dim);
  }

  .bf__wa {
    margin-top: 2rem;
  }

  .bf__form {
    display: grid;
    gap: 1.5rem;
  }

  .bf__row {
    display: grid;
    gap: 1.5rem;
  }

  .bf__field {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .bf__field > span {
    font-size: 0.58rem;
    color: var(--dim);
  }

  .bf__field input,
  .bf__field select,
  .bf__field textarea {
    width: 100%;
    padding: 0.95rem 1.05rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--paper);
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    resize: vertical;
    transition: border-color 0.2s var(--ease);
  }

  .bf__field select {
    appearance: none;
    cursor: pointer;
  }

  .bf__field input:focus,
  .bf__field select:focus,
  .bf__field textarea:focus {
    border-color: var(--tint);
  }

  .bf__hint {
    font-size: 0.76rem;
    color: var(--dim);
    opacity: 0.8;
  }

  .bf__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .bf__fieldset legend {
    padding: 0 0 0.85rem;
    font-size: 0.58rem;
    color: var(--dim);
  }

  .bf__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .bf__check {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1rem;
    font-size: 0.86rem;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .bf__check:hover {
    border-color: rgba(244, 241, 234, 0.3);
  }

  .bf__check input {
    width: 15px;
    height: 15px;
    accent-color: var(--tint);
    cursor: pointer;
  }

  .bf__check:has(input:checked) {
    border-color: var(--tint);
    color: var(--paper);
  }

  .bf__sep {
    margin-block: 0.6rem;
  }

  .bf__submit {
    justify-self: start;
    margin-top: 0.4rem;
  }

  @media (min-width: 620px) {
    .bf__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .bf__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
      gap: clamp(3rem, 6vw, 7rem);
    }
    .bf__head {
      position: sticky;
      top: calc(var(--header-h) + 40px);
    }
  }
</style>
