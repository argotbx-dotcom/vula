---
// One-page narrativa in tre atti (cap. 2 e 3 del piano):
// I. il caos — hero + manifesto + il problema
// II. il metodo — le sei fasi
// III. la prova — il vault, i numeri, il modello, la CTA
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Hero from '../sections/Hero.astro';
import Manifesto from '../sections/Manifesto.astro';
import Problem from '../sections/Problem.astro';
import Method from '../sections/Method.astro';
import Vault from '../sections/Vault.astro';
import Doors from '../sections/Doors.astro';
import Network from '../sections/Network.astro';
import Numbers from '../sections/Numbers.astro';
import Model from '../sections/Model.astro';
import CtaFinal from '../sections/CtaFinal.astro';
import { hero, manifesto, siteName, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const title = `${siteName} — ${hero[lang].line1} ${hero[lang].line2}`;
const description = manifesto[lang].join(' ');
---

<Base lang={lang} page="home" title={title} description={description}>
  <Header lang={lang} page="home" />
  <main id="main">
    <Hero lang={lang} />
    <Manifesto lang={lang} />
    <Problem lang={lang} />
    <Method lang={lang} />
    <Vault lang={lang} />
    <Doors lang={lang} />
    <Network lang={lang} />
    <Numbers lang={lang} />
    <Model lang={lang} />
    <CtaFinal lang={lang} />
  </main>
  <Footer lang={lang} page="home" />
</Base>
