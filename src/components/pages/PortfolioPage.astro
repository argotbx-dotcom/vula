---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageIntro from '../sections/PageIntro.astro';
import PortfolioCard from '../PortfolioCard.astro';
import GyozaLabTile from '../brand-partners/GyozaLabTile.astro';
import CtaFinal from '../sections/CtaFinal.astro';
import { nav, motto, type Lang } from '../../content/site';
import { groupBrands, conceptProjects, clients } from '../../content/portfolio';
import locateFinito from '../../assets/images/07-locale-finito.png';
import eliteWinesImg from '../../assets/partners/elite-wines-bottles.webp';
import zenonImg from '../../assets/partners/zenon-granola.png';
import pastaImg from '../../assets/partners/la-pasta-de-casa.png';
import polarikoImg from '../../assets/partners/polariko-label.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const n = nav[lang];

// Immagini reali fornite dal committente per marchi del gruppo e concept
// (foto/etichette dei loro stessi materiali, non foto stock).
const mediaAlt: Record<Lang, Record<string, string>> = {
  sq: {
    'elite-wines': 'Shishe vere premium Elite Wines',
    zenon: 'Snack natyral Zen’on me granola',
    'concept-1': 'Pjata pasta të freskëta, La Pasta de Casa',
    'concept-3': 'Etiketë prodhimi Polariko',
  },
  it: {
    'elite-wines': 'Bottiglie di vino premium Elite Wines',
    zenon: 'Snack naturale Zen’on con granola',
    'concept-1': 'Piatti di pasta fresca, La Pasta de Casa',
    'concept-3': 'Etichetta prodotto Polariko',
  },
  en: {
    'elite-wines': 'Premium Elite Wines wine bottles',
    zenon: 'Natural Zen’on snack with granola',
    'concept-1': 'Fresh pasta dishes, La Pasta de Casa',
    'concept-3': 'Polariko product label',
  },
};

const portfolioImages: Record<string, ImageMetadata> = {
  'elite-wines': eliteWinesImg,
  zenon: zenonImg,
  'concept-1': pastaImg,
  'concept-3': polarikoImg,
};

const sectionTitles: Record<Lang, { group: string; concept: string; client: string }> = {
  sq: { group: 'Markat e grupit', concept: 'Konceptet', client: 'Klientët' },
  it: { group: 'Marchi del gruppo', concept: 'Concept', client: 'Clienti' },
  en: { group: 'Group brands', concept: 'Concepts', client: 'Clients' },
};

const clientsNote: Record<Lang, string> = {
  sq: 'Seksioni i klientëve po plotësohet. Kur hapim një lokal të parë klienti, del këtu — me emër dhe etiketë të vërtetë, jo më parë.',
  it: 'La sezione clienti si sta riempiendo. Quando apriamo il primo locale di un cliente, compare qui — con nome ed etichetta reale, non prima.',
  en: "The clients section is filling up. When we open the first client's premises, it appears here — with a real name and label, not before.",
};

const resultAlt: Record<Lang, string> = {
  sq: 'Lokal i përfunduar, materiale të errëta elegante, dritë dramatike',
  it: 'Locale finito, materiali scuri eleganti, luce drammatica',
  en: 'Finished venue, elegant dark materials, dramatic lighting',
};
---

<Base lang={lang} page="portfolio" title={n.portfolio}>
  <Header lang={lang} page="portfolio" />
  <main id="main">
    <PageIntro lang={lang} kicker={motto[lang]} title={n.portfolio} />

    <section class="portfolio-result reveal">
      <div class="container">
        <Image src={locateFinito} alt={resultAlt[lang]} width={1400} height={788} loading="eager" />
      </div>
    </section>

    <section class="portfolio-group">
      <div class="container">
        <h2 class="reveal">{sectionTitles[lang].group}</h2>
        <div class="portfolio-grid">
          {
            groupBrands.map((item, i) => (
              <div class="reveal" style={`transition-delay:${i * 60}ms`}>
                <PortfolioCard lang={lang} item={item} image={portfolioImages[item.id]} imageAlt={mediaAlt[lang][item.id]} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="portfolio-concept">
      <div class="container">
        <h2 class="reveal">{sectionTitles[lang].concept}</h2>
        <div class="portfolio-grid">
          {
            conceptProjects.map((item, i) => (
              <div class="reveal" style={`transition-delay:${i * 50}ms`}>
                {item.id === 'concept-4' ? (
                  <PortfolioCard lang={lang} item={item}>
                    <GyozaLabTile slot="media" />
                  </PortfolioCard>
                ) : (
                  <PortfolioCard lang={lang} item={item} image={portfolioImages[item.id]} imageAlt={mediaAlt[lang][item.id]} />
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="portfolio-clients">
      <div class="container">
        <h2 class="reveal">{sectionTitles[lang].client}</h2>
        {clients.length === 0 && <p class="portfolio-clients__note reveal">{clientsNote[lang]}</p>}
      </div>
    </section>

    <CtaFinal lang={lang} />
  </main>
  <Footer lang={lang} page="portfolio" />
</Base>

<style>
  .portfolio-result img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .portfolio-group h2,
  .portfolio-concept h2,
  .portfolio-clients h2 {
    margin-bottom: 32px;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  .portfolio-clients {
    padding-top: 0;
  }

  .portfolio-clients__note {
    max-width: 60ch;
    color: var(--dim);
  }
</style>
