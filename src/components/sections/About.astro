---
import { Image } from 'astro:assets';
import { aboutThesis, path, ui, type Lang } from '../../content/site';
import studioNotte from '../../assets/images/03-studio-notte.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = aboutThesis[lang];
const t = ui[lang];

const stats: { to: number; labelKey: Record<Lang, string> }[] = [
  { to: 3, labelKey: { sq: 'markat tona', it: 'nostri marchi', en: 'our own brands' } },
  { to: 4, labelKey: { sq: 'faza', it: 'fasi', en: 'phases' } },
];

const aboutMore: Record<Lang, string> = {
  sq: 'Më shumë për ne',
  it: 'Di più su di noi',
  en: 'More about us',
};
---

<section class="about">
  <div class="container about__grid">
    <div class="about__media reveal">
      <Image
        src={studioNotte}
        alt={lang === 'sq'
          ? 'Studio krijues natën, dritë e vetme e ftohtë blu'
          : lang === 'it'
            ? 'Studio creativo di notte, unica luce fredda blu'
            : 'Creative studio at night, single cold blue light'}
        width={900}
        height={600}
        loading="lazy"
      />
    </div>
    <div class="about__text">
      <p class="kicker reveal">{a.kicker}</p>
      <h2 class="reveal">{a.line}</h2>

      <p class="about__note mono todo-inline reveal">
        <!-- DA FORNIRE: paragrafo esteso "chi siamo" per la pagina /kush-jemi, SQ/IT/EN -->
        [{t.todo} — testo esteso]
      </p>

      <div class="about__stats reveal">
        {
          stats.map((s) => (
            <div class="about__stat">
              <span class="about__stat-num" data-count-to={s.to}>0</span>
              <span class="about__stat-label mono">{s.labelKey[lang]}</span>
            </div>
          ))
        }
      </div>

      <a class="btn btn--ghost about__link" href={path(lang, 'about')}>{aboutMore[lang]}</a>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .about__media img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .about__text h2 {
    max-width: 14ch;
    margin-top: 8px;
  }

  .about__note {
    margin-top: 20px;
    display: inline-block;
    border: 1px dashed var(--timbro);
    padding: 10px 14px;
    color: var(--timbro);
    font-size: 0.68rem;
  }

  .about__stats {
    display: flex;
    gap: 40px;
    margin-top: 36px;
  }

  .about__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .about__stat-num {
    font-family: var(--font-mono);
    font-size: 2.4rem;
    color: var(--paper);
    font-weight: 500;
  }

  .about__stat-label {
    color: var(--dim);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .about__link {
    margin-top: 32px;
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
