---
// CTA finale a schermo intero (cap. 3).
import {
  ctaFinal,
  ctaMeets,
  ctaNote,
  path,
  sectionIds,
  whatsappNumber,
  whatsappIntro,
  whatsappCta,
  type Lang,
} from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = ctaFinal[lang];
const meetsCta = ctaMeets[lang];
// Assoluto sulla home: questa CTA compare anche sulle pagine concept, dove la
// sezione Meets non esiste.
const meetsHref = `${path(lang, 'home')}#${sectionIds.meets}`;
const wa = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappIntro[lang])}`
  : null;
---

<section class="cta" id={sectionIds.cta}>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="container cta__inner">
    <h2 class="display display--lg cta__title" data-reveal-line>
      <span>{c.line1}</span>
      <span class="cta__accent">{c.line2}</span>
    </h2>

    <div class="cta__act" data-reveal data-reveal-delay="0.2">
      <div class="cta__row">
        <a class="btn btn--primary cta__btn" href={path(lang, 'contact')} data-magnetic="12">
          {c.button}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost cta__btn" href={meetsHref} data-magnetic="8">
          {meetsCta.button}
          {/* La sezione Meets sta sopra questa CTA: la freccia in giù mentiva. */}
          <span class="btn__arrow btn__arrow--up" aria-hidden="true">↑</span>
        </a>
      </div>

      <p class="cta__second">{meetsCta.line}</p>
      <p class="cta__note mono">{ctaNote[lang]}</p>

      {
        wa && (
          <a class="cta__wa mono" href={wa} target="_blank" rel="noopener noreferrer">
            {whatsappCta[lang]}
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    min-height: 84svh;
    display: flex;
    align-items: center;
    padding-block: clamp(90px, 12vw, 160px);
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  .cta__title {
    display: flex;
    flex-direction: column;
    max-width: 16ch;
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .cta__accent {
    color: var(--accent);
  }

  .cta__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .cta__act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
  }

  /* La seconda strada va spiegata in una riga: chi ha capitale o cerca un
     socio non deve finire nello stesso imbuto di chi ha un progetto. */
  .cta__second {
    font-size: 0.95rem;
    color: var(--dim);
    max-width: 42ch;
  }

  .cta__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    color: var(--tint);
    text-decoration: none;
  }

  .cta__note {
    font-size: 0.62rem;
    line-height: 1.7;
    color: var(--dim);
    max-width: 38ch;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .cta__btn {
    padding: 1.35rem 2.4rem;
    font-size: 0.78rem;
  }

  /* La freccia orizzontale scorre a destra all'hover; questa punta in alto e
     deve muoversi nella sua direzione. */
  .cta__btn:hover .btn__arrow--up {
    transform: translateY(-3px);
  }
</style>
