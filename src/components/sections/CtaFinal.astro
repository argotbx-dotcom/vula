---
// CTA finale a schermo intero (cap. 3).
import { ctaFinal, ctaNote, path, sectionIds, whatsappNumber, whatsappIntro, whatsappCta, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = ctaFinal[lang];
const wa = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappIntro[lang])}`
  : null;
---

<section class="cta" id={sectionIds.cta}>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="container cta__inner">
    <h2 class="display display--lg cta__title" data-reveal-line>
      <span>{c.line1}</span>
      <span class="cta__accent">{c.line2}</span>
    </h2>

    <div class="cta__act" data-reveal data-reveal-delay="0.2">
      <div class="cta__row">
        <a class="btn btn--primary cta__btn" href={path(lang, 'contact')} data-magnetic="12">
          {c.button}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        {
          wa && (
            <a class="btn btn--ghost cta__btn" href={wa} target="_blank" rel="noopener noreferrer" data-magnetic="8">
              {whatsappCta[lang]}
              <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
      <p class="cta__note mono">{ctaNote[lang]}</p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    min-height: 84svh;
    display: flex;
    align-items: center;
    padding-block: clamp(90px, 12vw, 160px);
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  .cta__title {
    display: flex;
    flex-direction: column;
    max-width: 16ch;
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .cta__accent {
    color: var(--accent);
  }

  .cta__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .cta__act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
  }

  .cta__note {
    font-size: 0.62rem;
    line-height: 1.7;
    color: var(--dim);
    max-width: 38ch;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .cta__btn {
    padding: 1.35rem 2.4rem;
    font-size: 0.78rem;
  }
</style>
