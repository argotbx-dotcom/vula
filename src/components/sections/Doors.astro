---
// Tre porte d'ingresso.
// Non è una sequenza: sono tre alternative, quindi niente numerazione 01/02/03
// — la numerazione direbbe una cosa falsa sul contenuto.
import { doors, services, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = doors[lang];
const sv = services[lang];
---

<section class="dr" id="dyert">
  <div class="container">
    <header class="dr__head">
      <p class="kicker" data-reveal>{d.kicker}</p>
      <h2 class="display display--md dr__title" data-reveal data-reveal-delay="0.05">{d.title}</h2>
    </header>

    <ul class="dr__grid">
      {
        d.items.map((item, i) => (
          <li class="dr__item" data-reveal data-reveal-delay={i * 0.08}>
            <span class="dr__mark" aria-hidden="true"></span>
            <h3 class="dr__name">{item.title}</h3>
            <p class="dr__line">{item.line}</p>
          </li>
        ))
      }
    </ul>

    <!-- espansione della terza porta: il menu di ciò che si compra da solo -->
    <div class="dr__services">
      <div class="dr__sv-head" data-reveal>
        <h3 class="display display--md dr__sv-title">{sv.title}</h3>
        <p class="dr__sv-note mono">{sv.note}</p>
      </div>

      <div class="dr__sv-grid">
        {
          sv.groups.map((g, i) => (
            <div class="dr__sv-group" data-reveal data-reveal-delay={(i % 3) * 0.06}>
              <h4 class="dr__sv-name mono">{g.title}</h4>
              <ul class="dr__sv-list">
                {g.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .dr {
    padding-block: clamp(80px, 10vw, 150px);
  }

  .dr__head {
    margin-bottom: clamp(2.2rem, 4vw, 3.5rem);
  }

  .dr__title {
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .dr__grid {
    display: grid;
    gap: clamp(24px, 3vw, 44px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dr__item {
    display: grid;
    gap: 0.85rem;
    padding: clamp(22px, 3vw, 32px);
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    transition: border-color 0.25s var(--ease);
  }

  .dr__item:hover {
    border-color: rgba(244, 241, 234, 0.26);
  }

  /* soglia: una porta, non un numero */
  .dr__mark {
    width: 34px;
    height: 3px;
    background: var(--accent);
    border-radius: 999px;
  }

  .dr__name {
    font-size: clamp(1.05rem, 1.7vw, 1.32rem);
    letter-spacing: 0.01em;
  }

  .dr__line {
    color: var(--dim);
    font-size: 0.95rem;
  }

  /* servizi */
  .dr__services {
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
  }

  .dr__sv-head {
    display: grid;
    gap: 0.9rem;
    padding-bottom: 1.5rem;
    margin-bottom: clamp(1.8rem, 3vw, 2.6rem);
    border-bottom: 1px solid var(--line);
  }

  .dr__sv-title {
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .dr__sv-note {
    font-size: 0.66rem;
    color: var(--accent);
  }

  .dr__sv-grid {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
  }

  .dr__sv-group {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .dr__sv-name {
    font-size: 0.62rem;
    color: var(--paper);
  }

  .dr__sv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.42rem;
    font-size: 0.92rem;
    color: var(--dim);
  }

  @media (min-width: 860px) {
    .dr__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .dr__sv-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .dr__sv-note {
      text-align: right;
    }
    .dr__sv-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .dr__sv-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
