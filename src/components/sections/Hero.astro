---
import { getImage } from 'astro:assets';
import { motto, positioning, ctaPrimary, ctaSecondary, path, type Lang } from '../../content/site';
import heroPoster from '../../assets/images/hero-poster.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const poster = await getImage({ src: heroPoster, width: 1600, format: 'webp' });
---

<section class="hero">
  <div class="hero__media">
    <video
      id="hero-video"
      class="hero__video"
      poster={poster.src}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-src="/videos/hero.mp4"
    >
    </video>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1 class="reveal">{motto[lang]}</h1>
    <p class="hero__sub reveal">{positioning[lang]}</p>
    <div class="hero__actions reveal">
      <a class="btn btn--primary" href={path(lang, 'contact')}>{ctaPrimary[lang]}</a>
      <a class="btn btn--ghost" href={path(lang, 'services')}>{ctaSecondary[lang]}</a>
    </div>
  </div>
</section>

<script>
  // Video hero: caricato solo se non prefers-reduced-motion e la connessione
  // non è dichiarata "lenta" (brief §5: altrimenti si mostra solo il poster).
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (video) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as any).connection;
    const isSlow = conn && (conn.saveData || ['slow-2g', '2g'].includes(conn.effectiveType));

    if (!prefersReduced && !isSlow) {
      const source = document.createElement('source');
      source.src = video.dataset.src ?? '';
      source.type = 'video/mp4';
      video.appendChild(source);
      video.load();
      video.play().catch(() => {
        /* autoplay silenzioso rifiutato: resta visibile il poster */
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 880px);
    display: flex;
    align-items: flex-end;
    padding-block: 0;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--surface2);
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 16, 20, 0.35) 0%, rgba(16, 16, 20, 0.55) 55%, rgba(16, 16, 20, 0.94) 100%);
  }

  .hero__content {
    position: relative;
    padding-block: clamp(48px, 10vw, 96px);
    max-width: 820px;
  }

  .hero__content h1 {
    max-width: 14ch;
  }

  .hero__sub {
    margin-top: 18px;
    max-width: 46ch;
    color: var(--dim);
    font-size: 1.05rem;
  }

  .hero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
