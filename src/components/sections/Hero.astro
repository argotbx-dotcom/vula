---
// ATTO I — il caos (cap. 2 del piano).
// Video HERO-01 in loop muto, titolo a rivelazione riga per riga, CTA unica.
import { hero, heroKicker, ctaFinal, ctaSecondary, path, ui, sectionIds, type Lang } from '../../content/site';
import LoopVideo from '../LoopVideo.astro';
import heroPoster from '../../assets/posters/hero.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = hero[lang];
const t = ui[lang];
---

<section class="hero">
  <div class="hero__media">
    <LoopVideo name="hero" poster={heroPoster} width={1800} class="hero__video" />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="kicker hero__kicker" data-reveal>{heroKicker[lang]}</p>

    <h1 class="display display--xl hero__title" data-reveal-line>
      <span class="hero__line">{h.line1}</span>
      <span class="hero__line hero__line--accent">{h.line2}</span>
    </h1>

    <div class="hero__actions" data-reveal data-reveal-delay="0.25">
      <a class="btn btn--primary" href={path(lang, 'contact')} data-magnetic="9">
        {ctaFinal[lang].button}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={`#${sectionIds.method}`} data-magnetic="6">{ctaSecondary[lang]}</a>
    </div>
  </div>

  <div class="hero__scroll mono" aria-hidden="true">
    <span>&lt;{t.scroll}&gt;</span>
    <i class="hero__scroll-line"></i>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 0 clamp(80px, 12vh, 150px);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--ink-2);
  }

  .hero__media :global(.hero__video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 30% 45%, rgba(10, 10, 11, 0.15), transparent 70%),
      linear-gradient(to bottom, rgba(10, 10, 11, 0.72) 0%, rgba(10, 10, 11, 0.4) 38%, rgba(10, 10, 11, 0.95) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__kicker {
    color: var(--accent);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    max-width: 18ch;
  }

  .hero__line {
    display: block;
  }

  .hero__line--accent {
    color: var(--accent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 3.25rem);
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(80px, 12vh, 150px);
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.6rem;
    color: var(--dim);
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, var(--dim), transparent);
  }

  @media (min-width: 900px) {
    .hero__scroll {
      display: flex;
    }
  }
</style>
