---
import type { Lang } from '../../content/site';

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---

<section class="page-intro">
  <div class="container">
    <p class="kicker reveal">{kicker}</p>
    <h1 class="reveal">{title}</h1>
  </div>
</section>

<style>
  .page-intro {
    padding-block: clamp(56px, 12vw, 120px) clamp(32px, 6vw, 56px);
  }
</style>
