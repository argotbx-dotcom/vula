---
import { phases, ui, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
  detailed?: boolean;
}
const { lang, detailed = false } = Astro.props;
const list = phases[lang];
const t = ui[lang];

function priceText(p: (typeof list)[number]): string {
  if (p.priceKind === 'range') return p.priceValue ?? '';
  if (p.priceKind === 'package') return t.pricePackage;
  return t.priceQuote;
}
---

<ol class="phases">
  {
    list.map((p, i) => (
      <li class="phases__item reveal" style={`transition-delay:${i * 70}ms`}>
        <div class="phases__head">
          <span class="phases__num phase-num">{p.num}</span>
          <h3 class="phases__code">{p.code}</h3>
        </div>
        <p class="phases__desc">{p.desc}</p>
        {p.highlight && <p class="phases__highlight">{p.highlight}</p>}
        <div class="phases__price">
          <span class="price">{priceText(p)}</span>
          {!p.priceConfirmed && <span class="label label--todo mono">{t.priceTbc}</span>}
        </div>
        {detailed && (
          <p class="phases__note mono todo-note">
            <!-- [DA CONFERMARE]: prezzi indicativi dal brief, da verificare col committente prima della pubblicazione -->
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .phases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .phases__item {
    background: var(--ink);
    padding: clamp(24px, 4vw, 40px);
    display: grid;
    gap: 12px;
  }

  .phases__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .phases__num {
    color: var(--timbro);
    font-size: 1rem;
  }

  .phases__code {
    font-size: 1.1rem;
  }

  .phases__desc {
    color: var(--dim);
    max-width: 62ch;
  }

  .phases__highlight {
    color: var(--paper);
    font-weight: 500;
    border-left: 2px solid var(--timbro);
    padding-left: 14px;
  }

  .phases__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
  }

  .phases__price .price {
    color: var(--paper);
    font-size: 0.82rem;
  }
</style>
