---
import { path, ui, type Lang } from '../../content/site';
import { groupBrands, conceptProjects, clients } from '../../content/portfolio';
import PortfolioCard from '../PortfolioCard.astro';
import GyozaLabTile from '../brand-partners/GyozaLabTile.astro';
import eliteWinesImg from '../../assets/partners/elite-wines-bottles.webp';
import zenonImg from '../../assets/partners/zenon-granola.png';
import pastaImg from '../../assets/partners/la-pasta-de-casa.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// Vetrina in home: solo schede con visual reale, per il massimo impatto —
// il portfolio completo (con tutte le schede, comprese quelle in attesa di
// immagine) resta su /puna.
const byId = (id: string) => [...groupBrands, ...conceptProjects].find((p) => p.id === id)!;
const preview = ['elite-wines', 'zenon', 'concept-1', 'concept-4'].map(byId);

const mediaAlt: Record<Lang, Record<string, string>> = {
  sq: { 'elite-wines': 'Shishe vere premium Elite Wines', zenon: 'Snack natyral Zen’on me granola', 'concept-1': 'Pjata pasta të freskëta, La Pasta de Casa' },
  it: { 'elite-wines': 'Bottiglie di vino premium Elite Wines', zenon: 'Snack naturale Zen’on con granola', 'concept-1': 'Piatti di pasta fresca, La Pasta de Casa' },
  en: { 'elite-wines': 'Premium Elite Wines wine bottles', zenon: 'Natural Zen’on snack with granola', 'concept-1': 'Fresh pasta dishes, La Pasta de Casa' },
};

const portfolioImages: Record<string, ImageMetadata> = {
  'elite-wines': eliteWinesImg,
  zenon: zenonImg,
  'concept-1': pastaImg,
};

const title: Record<Lang, string> = {
  sq: 'Puna',
  it: 'I lavori',
  en: 'The work',
};

const clientsNote: Record<Lang, string> = {
  sq: 'Seksioni i klientëve po plotësohet.',
  it: 'La sezione clienti si sta riempiendo.',
  en: 'The clients section is filling up.',
};
---

<section class="pf-preview">
  <div class="container">
    <div class="pf-preview__header reveal">
      <h2>{title[lang]}</h2>
      <a class="btn btn--ghost" href={path(lang, 'portfolio')}>{t.portfolioAll}</a>
    </div>

    <div class="pf-preview__grid">
      {
        preview.map((item, i) => (
          <div class="reveal" style={`transition-delay:${i * 60}ms`}>
            {item.id === 'concept-4' ? (
              <PortfolioCard lang={lang} item={item} large>
                <GyozaLabTile slot="media" />
              </PortfolioCard>
            ) : (
              <PortfolioCard lang={lang} item={item} image={portfolioImages[item.id]} imageAlt={mediaAlt[lang][item.id]} large />
            )}
          </div>
        ))
      }
    </div>

    {
      clients.length === 0 && (
        <p class="pf-preview__clients-note mono reveal">{clientsNote[lang]}</p>
      )
    }
  </div>
</section>

<style>
  .pf-preview__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .pf-preview__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .pf-preview__clients-note {
    margin-top: 32px;
    color: var(--dim);
    font-size: 0.72rem;
  }
</style>
