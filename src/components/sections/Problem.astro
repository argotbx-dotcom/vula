---
// Il problema — otto etichette in disordine che si allineano di scatto
// su una riga sola sotto il claim (cap. 3).
import { problem, sectionIds, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = problem[lang];
---

<section class="pb" id={sectionIds.problem}>
  <div class="container">
    <p class="kicker" data-reveal>{p.kicker}</p>

    <h2 class="display display--lg pb__claim" data-reveal data-reveal-delay="0.05">{p.claim}</h2>

    <div class="pb__field" data-chaos>
      <ul class="pb__chips">
        {
          p.labels.map((l) => (
            <li class="pb__chip mono" data-chip>
              {l}
            </li>
          ))
        }
      </ul>
    </div>

    <p class="display display--lg pb__resolve" data-reveal>{p.resolve}</p>
  </div>
</section>

<style>
  .pb {
    padding-block: clamp(80px, 10vw, 150px);
  }

  .pb__claim {
    max-width: 16ch;
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .pb__field {
    margin-block: clamp(3rem, 7vw, 6rem);
  }

  .pb__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pb__chip {
    padding: 0.7rem 1.15rem;
    font-size: 0.66rem;
    color: var(--dim);
    border: 1px solid var(--line);
    border-radius: 999px;
    white-space: nowrap;
    will-change: transform;
  }

  .pb__resolve {
    color: var(--accent);
    text-align: center;
    text-transform: none;
  }

  @media (min-width: 900px) {
    .pb__chips {
      flex-wrap: nowrap;
    }
  }
</style>
