---
// ATTO III — la prova (cap. 2 e 3).
// Due gruppi tenuti rigorosamente separati: i progetti sviluppati per clienti
// e i concept nostri, mai aperti. Ogni scheda porta la propria etichetta.
import { vault, vaultGroups, sectionIds, type Lang } from '../../content/site';
import { clients, conceptProjects } from '../../content/vault';
import ConceptCard from '../ConceptCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const v = vault[lang];
const g = vaultGroups[lang];
---

<section class="vt" id={sectionIds.vault}>
  <div class="container">
    <header class="vt__head">
      <div>
        <p class="kicker" data-reveal>{v.kicker}</p>
        <h2 class="display display--lg vt__title" data-reveal data-reveal-delay="0.05">{v.title}</h2>
      </div>
      <p class="vt__note" data-reveal data-reveal-delay="0.1">{v.note}</p>
    </header>

    <!-- progetti per clienti -->
    <div class="vt__group">
      <div class="vt__group-head" data-reveal>
        <h3 class="vt__group-title">{g.client.title}</h3>
        <p class="vt__group-note">{g.client.note}</p>
      </div>

      <div class="vt__grid vt__grid--lead">
        {
          clients.map((c, i) => (
            <div data-reveal data-reveal-delay={(i % 2) * 0.08}>
              <ConceptCard lang={lang} concept={c} size="lg" />
            </div>
          ))
        }
      </div>
    </div>

    <!-- concept nostri -->
    <div class="vt__group">
      <div class="vt__group-head" data-reveal>
        <h3 class="vt__group-title">{g.concept.title}</h3>
        <p class="vt__group-note">{g.concept.note}</p>
      </div>

      <div class="vt__grid">
        {
          conceptProjects.map((c, i) => (
            <div data-reveal data-reveal-delay={(i % 3) * 0.07}>
              <ConceptCard lang={lang} concept={c} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .vt {
    padding-block: clamp(90px, 12vw, 170px);
  }

  .vt__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .vt__title {
    max-width: 16ch;
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .vt__note {
    color: var(--dim);
    font-size: 0.95rem;
    max-width: 44ch;
  }

  .vt__group + .vt__group {
    margin-top: clamp(4rem, 8vw, 7.5rem);
  }

  .vt__group-head {
    display: grid;
    gap: 0.7rem;
    padding-bottom: 1.4rem;
    margin-bottom: clamp(1.8rem, 3vw, 2.8rem);
    border-bottom: 1px solid var(--line);
  }

  .vt__group-title {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: 0.01em;
  }

  .vt__group-note {
    color: var(--dim);
    font-size: 0.92rem;
    max-width: 58ch;
  }

  .vt__grid {
    display: grid;
    gap: clamp(28px, 3.5vw, 56px);
  }

  @media (min-width: 760px) {
    .vt__head {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }
    .vt__group-head {
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      gap: 1.5rem 3rem;
      align-items: baseline;
    }
    .vt__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .vt__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    /* specificità doppia: deve battere .vt__grid nello stesso media query */
    .vt__grid.vt__grid--lead {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
