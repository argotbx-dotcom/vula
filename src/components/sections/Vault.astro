---
// ATTO III — la prova. Koncept Vault (cap. 2 e 3).
// Griglia editoriale sfalsata: i concept già creati, vivi.
import { vault, sectionIds, type Lang } from '../../content/site';
import { concepts } from '../../content/vault';
import ConceptCard from '../ConceptCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const v = vault[lang];

// Ritmo editoriale: le prime due schede grandi, poi il resto a tre colonne.
const lead = concepts.slice(0, 2);
const rest = concepts.slice(2);
---

<section class="vt" id={sectionIds.vault}>
  <div class="container">
    <header class="vt__head">
      <div>
        <p class="kicker" data-reveal>{v.kicker}</p>
        <h2 class="display display--lg vt__title" data-reveal data-reveal-delay="0.05">{v.title}</h2>
      </div>
      <p class="vt__note" data-reveal data-reveal-delay="0.1">{v.note}</p>
    </header>

    <div class="vt__lead">
      {
        lead.map((c, i) => (
          <div data-reveal data-reveal-delay={i * 0.08}>
            <ConceptCard lang={lang} concept={c} size="lg" />
          </div>
        ))
      }
    </div>

    <div class="vt__grid">
      {
        rest.map((c, i) => (
          <div data-reveal data-reveal-delay={(i % 3) * 0.08}>
            <ConceptCard lang={lang} concept={c} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vt {
    padding-block: clamp(90px, 12vw, 170px);
  }

  .vt__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .vt__title {
    max-width: 16ch;
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .vt__note {
    color: var(--dim);
    font-size: 0.95rem;
    max-width: 42ch;
  }

  .vt__lead,
  .vt__grid {
    display: grid;
    gap: clamp(28px, 3.5vw, 56px);
  }

  .vt__lead {
    margin-bottom: clamp(28px, 3.5vw, 56px);
  }

  @media (min-width: 760px) {
    .vt__head {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }
    .vt__lead {
      grid-template-columns: 1fr 1fr;
    }
    .vt__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .vt__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
