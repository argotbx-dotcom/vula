---
// VULA MEETS — la piazza d'incontro (idee, capitale, soci).
//
// Al lancio NON è una piattaforma: niente account, niente login, niente
// progetto pubblico. Sono tre porte e tre questionari che arrivano in privato.
// Per questo qui non c'è nessun contatore e nessuna "trazione": la sezione è
// nuova e fingere il contrario violerebbe le regole di onestà del progetto.
//
// Le porte sono link veri alla pagina contatto: senza JavaScript portano
// comunque da qualche parte. Il JS li promuove ad apritori del <dialog>.
import {
  meets,
  meetsUi,
  doorsMeets,
  VULA_MEETS_FORM_IDS,
  isFormConfigured,
  formEndpoint,
  type MeetsField,
} from '../../content/meets';
import { sectionIds, path, whatsappNumber, whatsappIntro, type Lang } from '../../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const m = meets[lang];
const u = meetsUi[lang];

// Endpoint vuoto = recapito non ancora configurato. Il pannello lo dichiara
// invece di fingere un invio riuscito.
const endpointFor = (key: keyof typeof VULA_MEETS_FORM_IDS) => {
  const id = VULA_MEETS_FORM_IDS[key];
  return isFormConfigured(id) ? formEndpoint(id) : '';
};

const autocompleteFor: Record<string, string> = {
  emri: 'name',
  qyteti: 'address-level2',
  telefoni: 'tel',
  email: 'email',
};

const fieldId = (doorKey: string, f: MeetsField) => `vm-${doorKey}-${f.name}`;

// Stringhe che servono al JS: viaggiano come JSON, così il modulo resta
// indipendente dalla lingua.
const strings = {
  step: u.step,
  required: u.required,
  invalidEmail: u.invalidEmail,
  sending: u.sending,
  send: u.send,
  next: u.next,
  errorLine: u.errorLine,
  rateLimited: u.rateLimited,
  notConfigured: u.notConfigured,
  charsLeft: u.charsLeft,
};
---

<section class="vm" id={sectionIds.meets} data-meets>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="container vm__inner">
    <header class="vm__head">
      <p class="kicker" data-reveal>{m.kicker}</p>
      <h2 class="display display--lg vm__title" data-reveal data-reveal-delay="0.05">{m.title}</h2>
      <p class="display display--md vm__sub" data-reveal data-reveal-delay="0.1">{m.subtitle}</p>
      <p class="lede vm__lede" data-reveal data-reveal-delay="0.15">{m.lede}</p>
    </header>

    <ul class="vm__doors">
      {
        doorsMeets.map((d, i) => (
          <li class="vm__cell" data-reveal data-reveal-delay={0.08 * i}>
            <a
              class="vm__door"
              href={path(lang, 'contact')}
              data-meets-open
              data-door={d.key}
              data-door-title={d.title[lang]}
            >
              {/* Nessun viewBox: 1 unità utente = 1 px, così lo stroke non si
                  deforma su una card di larghezza fluida. pathLength normalizza
                  il perimetro a 100, quindi il bordo si disegna uguale a
                  qualunque dimensione, senza JavaScript. */}
              <svg class="vm__frame" aria-hidden="true" focusable="false">
                <rect pathLength="100" x="0" y="0" width="100%" height="100%" />
              </svg>

              <span class="vm__idx mono">{d.index}</span>
              <h3 class="vm__name">{d.title[lang]}</h3>
              <p class="vm__line">{d.line[lang]}</p>
              <span class="vm__go mono">
                {u.open}
                <span class="vm__arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="vm__privacy mono" data-reveal>{m.privacy}</p>
    <p class="vm__disclaimer" data-reveal>{m.disclaimer}</p>
  </div>

  <dialog
    class="vm__dlg"
    data-meets-dialog
    aria-labelledby="vm-title"
    data-wa={whatsappNumber}
    data-wa-intro={whatsappIntro[lang]}
  >
    <div class="vm__panel">
      <div class="vm__top">
        <div class="vm__bar" aria-hidden="true"><i class="vm__barfill" data-vm-bar></i></div>
        <div class="vm__toprow">
          <div class="vm__ident">
            <h2 class="vm__dlg-title" id="vm-title" data-vm-title></h2>
            <p class="vm__count mono" data-vm-count></p>
          </div>
          <button type="button" class="vm__x" data-vm-close aria-label={u.close}>
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </div>

      {/* Una sola live region, figlia diretta del pannello e fuori dai form:
          dentro un form sparirebbe dall'albero quando il form viene nascosto
          alla conferma. */}
      <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-vm-live></p>

      <div class="vm__scroll" data-lenis-prevent>
        {
          doorsMeets.map((d) => (
            <form
              class="vm__form"
              id={`vm-form-${d.key}`}
              data-vm-form={d.key}
              data-endpoint={endpointFor(d.key)}
              novalidate
              hidden
            >
              <input type="hidden" name="tipo" value={d.key} />
              <input type="hidden" name="gjuha" value={lang} />
              <input type="hidden" name="subject" value={`VULA MEETS · ${d.key} · {{ emri }}`} />
              {/* Honeypot nativo di Formspree: se arriva valorizzato l'invio
                  viene scartato. Fuori dal flusso a tab, mai required. */}
              <input class="vm__hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />

              {d.fields.map((f, i) => {
                const id = fieldId(d.key, f);
                const describedBy = f.hint ? `${id}-hint ${id}-err` : `${id}-err`;
                const enterHint = i === d.fields.length - 1 ? 'done' : 'next';

                return (
                  <div
                    class="vm__step"
                    data-vm-step
                    data-name={f.name}
                    data-label={f.label[lang]}
                    data-required={f.required ? 'true' : 'false'}
                    data-show-if-field={f.showIf?.field}
                    data-show-if-values={f.showIf?.equals.join('|')}
                    hidden
                  >
                    {f.kind === 'checkboxes' ? (
                      <fieldset class="vm__group">
                        <legend class="vm__q">{f.label[lang]}</legend>
                        {f.hint && <p class="vm__note" id={`${id}-hint`}>{f.hint[lang]}</p>}
                        <div class="vm__checks">
                          {f.options?.map((o) => (
                            <label class="vm__check">
                              <input type="checkbox" name={f.name} value={o.value} aria-describedby={describedBy} />
                              <span>{o.label[lang]}</span>
                            </label>
                          ))}
                        </div>
                      </fieldset>
                    ) : (
                      <Fragment>
                        <label class="vm__q" for={id}>
                          {f.label[lang]}
                          {!f.required && <span class="vm__opt mono">{u.optional}</span>}
                        </label>

                        {f.notice && <p class="vm__notice">{f.notice[lang]}</p>}

                        {f.kind === 'select' && (
                          <select id={id} name={f.name} aria-describedby={describedBy}>
                            <option value="">—</option>
                            {f.options?.map((o) => <option value={o.value}>{o.label[lang]}</option>)}
                          </select>
                        )}

                        {f.kind === 'textarea' && (
                          <Fragment>
                            <textarea
                              id={id}
                              name={f.name}
                              rows="4"
                              maxlength={f.maxlength}
                              placeholder={f.placeholder?.[lang]}
                              aria-describedby={describedBy}
                            />
                            {f.maxlength && <p class="vm__chars mono" data-vm-chars hidden />}
                          </Fragment>
                        )}

                        {f.kind !== 'select' && f.kind !== 'textarea' && (
                          <input
                            id={id}
                            name={f.name}
                            type={f.kind}
                            inputmode={f.kind === 'tel' ? 'tel' : undefined}
                            autocomplete={autocompleteFor[f.name]}
                            enterkeyhint={enterHint}
                            placeholder={f.placeholder?.[lang]}
                            aria-describedby={describedBy}
                          />
                        )}

                        {f.hint && <p class="vm__note" id={`${id}-hint`}>{f.hint[lang]}</p>}
                      </Fragment>
                    )}

                    {/* Referenziato da aria-describedby fin dal markup: l'id non
                        va aggiunto e tolto a runtime. */}
                    <p class="vm__err" id={`${id}-err`} data-vm-err hidden></p>
                  </div>
                );
              })}
            </form>
          ))
        }

        <div class="vm__done" hidden data-vm-done>
          <h2 class="display display--md vm__done-title" tabindex="-1" data-vm-done-title>{u.doneTitle}</h2>
          <p class="lede vm__done-line">{u.doneLine}</p>
          <button type="button" class="btn btn--ghost" data-vm-close>{u.close}</button>
        </div>
      </div>

      <div class="vm__foot" data-vm-foot>
        <p class="vm__status" data-vm-status hidden></p>
        <a class="vm__fallback mono" data-vm-fallback href="#" target="_blank" rel="noopener noreferrer" hidden>
          {u.errorWhatsapp}
          <span aria-hidden="true">↗</span>
        </a>
        <div class="vm__acts">
          <button type="button" class="btn btn--ghost vm__back" data-vm-back>{u.back}</button>
          <button type="submit" class="btn btn--primary vm__next" data-vm-next>{u.next}</button>
          <span class="vm__enter mono" data-vm-hint>{u.enterHint}</span>
        </div>
      </div>

      <script is:inline type="application/json" data-vm-i18n set:html={JSON.stringify(strings)} />
    </div>
  </dialog>
</section>

<script>
  import { initMeets } from '../../lib/meets';
  initMeets();
</script>

<style>
  /* ------------------------------------------------------------- sezione */

  .vm__inner {
    position: relative;
    z-index: 1;
  }

  .vm__title {
    text-transform: uppercase;
    letter-spacing: -0.015em;
  }

  .vm__sub {
    margin-top: clamp(0.75rem, 1.4vw, 1.1rem);
    color: var(--tint);
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .vm__lede {
    margin-top: 1.6rem;
  }

  /* --------------------------------------------------------- le tre porte */

  .vm__doors {
    display: grid;
    gap: clamp(20px, 2.4vw, 34px);
    margin: clamp(2.6rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .vm__cell {
    display: flex;
  }

  .vm__door {
    /* --bw guida sia lo stroke sia il rientro della geometria del rect */
    --bw: 1.5px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    padding: clamp(24px, 3vw, 36px);
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
    /* niente overflow: hidden, taglierebbe metà tratto del bordo */
  }

  /* Il telaio che si disegna. pointer-events: none o si mangia i click di
     tutta la card, non solo quelli sulla linea. */
  .vm__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .vm__frame rect {
    /* geometria in CSS: rientra di metà tratto, così la linea cade sul bordo */
    x: calc(var(--bw) / 2);
    y: calc(var(--bw) / 2);
    width: calc(100% - var(--bw));
    height: calc(100% - var(--bw));
    rx: 3px;

    fill: none;
    stroke: var(--tint);
    stroke-width: var(--bw);
    stroke-linecap: butt;

    /* pathLength="100" nel markup: 100px qui significano "tutto il
       perimetro", qualunque sia la dimensione della card. */
    stroke-dasharray: 100px;
    stroke-dashoffset: 100px;
  }

  .vm__idx {
    font-size: 0.66rem;
    color: var(--tint);
  }

  .vm__name {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    letter-spacing: -0.01em;
  }

  .vm__line {
    color: var(--dim);
    font-size: 0.95rem;
  }

  .vm__go {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.4rem;
    font-size: 0.62rem;
    color: var(--dim);
    transition: color 0.22s var(--ease);
  }

  .vm__arrow {
    transition: transform 0.22s var(--ease);
  }

  /* La transizione sta sulla regola base: è quella che governa l'uscita.
     In hover cambia solo la durata, così il bordo si riavvolge invece di
     sparire di scatto. */
  .vm__frame rect {
    transition: stroke-dashoffset 0.3s var(--ease);
  }

  .vm__door:focus-visible .vm__frame rect {
    stroke-dashoffset: 0;
    transition-duration: 0.7s;
  }

  .vm__door:focus-visible .vm__go,
  .vm__door:hover .vm__go {
    color: var(--paper);
  }

  .vm__door:hover .vm__arrow {
    transform: translateX(3px);
  }

  /* Solo dove il puntatore è vero: su touch il primo tap lascerebbe :hover
     appiccicato e la card resterebbe disegnata a metà. */
  @media (hover: hover) and (pointer: fine) {
    .vm__door:hover .vm__frame rect {
      stroke-dashoffset: 0;
      transition-duration: 0.7s;
    }
  }

  /* Su touch il bordo non è un'animazione ma un'affordance statica. */
  @media (hover: none) {
    .vm__frame rect {
      stroke-dashoffset: 0;
      opacity: 0.35;
      transition: none;
    }
  }

  /* Si toglie il movimento, non il segnale. */
  @media (prefers-reduced-motion: reduce) {
    .vm__frame rect {
      stroke-dashoffset: 0;
      opacity: 0;
      transition: opacity 0.12s linear;
    }
    .vm__door:hover .vm__frame rect,
    .vm__door:focus-visible .vm__frame rect {
      opacity: 1;
    }
  }

  /* ------------------------------------------------------ testi in calce */

  .vm__privacy {
    margin-top: clamp(2rem, 3.5vw, 3rem);
    font-size: 0.62rem;
    line-height: 1.7;
    color: var(--dim);
    text-transform: none;
    letter-spacing: 0.06em;
    max-width: 60ch;
  }

  .vm__disclaimer {
    margin-top: 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--dim);
    opacity: 0.75;
    max-width: 72ch;
  }

  @media (min-width: 860px) {
    .vm__doors {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ====================================================== il pannello ==== */
  /* <dialog> aperto con showModal(): il browser dà trappola del focus,
     inertizzazione del resto della pagina ed Esc. Sta nel top layer, quindi
     passa sopra header, cursore e preloader senza doverli conoscere. */

  .vm__dlg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;

    /* fallback prima della prima misura; poi il valore misurato */
    height: 100svh;
    height: var(--vvh);

    /* Su iOS il fixed è ancorato al layout viewport, che resta fermo mentre
       il visual viewport scorre in alto per scoprire il campo. */
    transform: translateY(var(--vvtop));

    /* La geometria deve inseguire la tastiera nello stesso frame: animarla
       scoprirebbe la pagina sotto per qualche centinaio di millisecondi. */
    transition: none !important;
    overscroll-behavior: contain;
  }

  .vm__dlg::backdrop {
    background: rgba(10, 10, 11, 0.92);
  }

  .vm__panel {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ------------------------------------------------------------ testata */

  .vm__top {
    flex: 0 0 auto;
    border-bottom: 1px solid var(--line);
  }

  .vm__bar {
    height: 2px;
    background: var(--line-soft);
  }

  /* scaleX, mai width: la regola del sito è animare solo transform e opacity */
  .vm__barfill {
    display: block;
    height: 100%;
    background: var(--tint);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s var(--ease);
  }

  .vm__toprow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(0.9rem, 2vw, 1.3rem) var(--gutter);
  }

  .vm__dlg-title {
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.01em;
  }

  .vm__count {
    margin-top: 0.4rem;
    font-size: 0.58rem;
    color: var(--dim);
  }

  .vm__x {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.22s var(--ease);
  }

  .vm__x:hover {
    border-color: var(--paper);
  }

  /* ------------------------------------------------------------- il corpo */

  .vm__scroll {
    flex: 1 1 auto;
    /* obbligatorio: senza, il corpo non si comprime e il piede esce dal
       pannello — sembra la tastiera che copre, ma è il flex */
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scroll-padding-block: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
  }

  .vm__form {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }

  .vm__step {
    display: grid;
    gap: 0.85rem;
  }

  .vm__q {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3.2vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-transform: none;
    padding: 0;
  }

  .vm__opt {
    margin-left: 0.7rem;
    font-size: 0.55rem;
    color: var(--dim);
    vertical-align: middle;
  }

  .vm__notice {
    padding: 0.85rem 1rem;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--paper);
    background: var(--ink-2);
    border-left: 2px solid var(--tint);
    border-radius: 2px;
  }

  .vm__note {
    font-size: 0.82rem;
    color: var(--dim);
  }

  .vm__chars {
    font-size: 0.6rem;
    color: var(--dim);
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .vm__err {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: #e07a5f;
  }

  /* Stessi valori dei campi della pagina contatto: il form deve sembrare la
     stessa mano. max(16px) perché sotto i 16 renderizzati iOS zooma al focus
     e non torna più indietro. */
  .vm__step input:not([type='checkbox']),
  .vm__step select,
  .vm__step textarea {
    width: 100%;
    padding: 0.95rem 1.05rem;
    font-family: var(--font-body);
    font-size: max(16px, 1rem);
    line-height: 1.35;
    color: var(--paper);
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    resize: vertical;
    transition: border-color 0.2s var(--ease);
  }

  .vm__step select {
    appearance: none;
    cursor: pointer;
  }

  .vm__step input:focus,
  .vm__step select:focus,
  .vm__step textarea:focus {
    border-color: var(--tint);
  }

  .vm__step [aria-invalid='true'] {
    border-color: #e07a5f;
  }

  .vm__group {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.85rem;
  }

  .vm__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .vm__check {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.05rem;
    font-size: 0.9rem;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  .vm__check input {
    width: 16px;
    height: 16px;
    accent-color: var(--tint);
    cursor: pointer;
  }

  .vm__check:has(input:checked) {
    border-color: var(--tint);
  }

  /* Honeypot: fuori dalla vista e fuori dal flusso a tab, mai display:none
     (alcuni bot lo usano proprio come segnale). */
  .vm__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ------------------------------------------------------------ conferma */

  .vm__done {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .vm__done-title {
    color: var(--tint);
    text-transform: none;
    letter-spacing: -0.015em;
  }

  .vm__done-title:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 6px;
  }

  /* --------------------------------------------------------------- piede */
  /* Sta sul bordo inferiore di --vvh: con la tastiera aperta è sopra la
     tastiera per costruzione, senza calcoli. */

  .vm__foot {
    flex: 0 0 auto;
    display: grid;
    gap: 0.75rem;
    padding: clamp(0.9rem, 2vw, 1.2rem) var(--gutter);
    padding-bottom: max(env(safe-area-inset-bottom), 1rem);
    border-top: 1px solid var(--line);
    background: var(--ink);
  }

  /* Con la tastiera aperta la safe area in basso è coperta dai tasti:
     lasciarla lì creerebbe una fascia vuota sopra la tastiera. */
  :global(html.is-keyboard) .vm__foot {
    padding-bottom: 0.9rem;
  }

  .vm__status {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: #e07a5f;
  }

  .vm__fallback {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    color: var(--tint);
  }

  .vm__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .vm__back,
  .vm__next {
    padding: 0.95rem 1.6rem;
