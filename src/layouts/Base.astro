---
import { LANGS, orgDescription, path, siteName, ui, type Lang, type RouteKey } from '../content/site';
import VulaMarchio from '../components/brand/VulaMarchio.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page?: RouteKey;
  /** Percorso canonico esplicito (pagine concept). */
  canonical?: string;
  /** Alternate per lingua (pagine concept). */
  alternates?: Record<Lang, string>;
  title: string;
  description: string;
  /** Colore di marca del concept: la pagina lo "indossa". */
  tint?: string;
  onTint?: string;
}

const {
  lang,
  page = 'home',
  canonical,
  alternates,
  title,
  description,
  tint,
  onTint,
} = Astro.props;

const t = ui[lang];

// URL ASSOLUTI: canonical, hreflang e og:image relativi non sono validi.
// Google ignora gli hreflang relativi e WhatsApp/LinkedIn non risolvono
// un'anteprima da un percorso relativo.
const abs = (p: string) => new URL(p, Astro.site).href;

const here = abs(canonical ?? path(lang, page));
const altPaths = alternates ?? (Object.fromEntries(LANGS.map((l) => [l, path(l, page)])) as Record<Lang, string>);
const alts = Object.fromEntries(LANGS.map((l) => [l, abs(altPaths[l])])) as Record<Lang, string>;
const ogImage = abs('/og.png');

// Open Graph vuole lingua_TERRITORIO: con il solo codice di lingua Facebook e
// LinkedIn ignorano il campo e ripiegano su en_US.
const ogLocale: Record<Lang, string> = { sq: 'sq_AL', it: 'it_IT', en: 'en_US' };

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  url: abs(path('sq')),
  image: ogImage,
  areaServed: { '@type': 'Country', name: 'Albania' },
  address: { '@type': 'PostalAddress', addressLocality: 'Tiranë', addressCountry: 'AL' },
  // La descrizione dell'azienda non cambia da pagina a pagina: quella della
  // pagina racconta il contenuto, non l'entità.
  description: orgDescription[lang],
  knowsLanguage: ['sq', 'it', 'en'],
};

const tintStyle = tint ? `--tint:${tint};--on-tint:${onTint ?? '#0a0a0b'};` : undefined;
---

<!doctype html>
<html lang={lang} style={tintStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={here} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alts[l]} />)}
    <link rel="alternate" hreflang="x-default" href={alts.sq} />

    <link rel="icon" type="image/svg+xml" href="/brand/svg/vula-favicon-bianco.svg" />
    <link rel="apple-touch-icon" href="/brand/png/vula-favicon-bianco-512.png" />
    <meta name="theme-color" content="#0a0a0b" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@700&f[]=general-sans@400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>

    <div class="preloader" data-preloader aria-hidden="true">
      <div class="preloader__inner">
        <span class="preloader__mark" data-preloader-mark>
          <VulaMarchio />
        </span>
        <span class="preloader__count" data-preloader-count>000</span>
      </div>
    </div>

    <div class="cursor" data-cursor aria-hidden="true">
      <span class="cursor__ring" data-cursor-ring>
        <span class="cursor__label" data-cursor-label></span>
      </span>
      <span class="cursor__dot" data-cursor-dot></span>
    </div>

    <slot />

    <script>
      import { initMotion } from '../lib/motion';
      initMotion();
    </script>
  </body>
</html>
